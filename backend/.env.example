# Postgres connection string, local dev points at the compose db
DATABASE_URL=postgresql://user:password@localhost:5432/codecritic

# Postgres connection string for the integration test database
DATABASE_URL_TEST=postgresql://user:password@localhost:5432/codecritic_test

# development | test | production
NODE_ENV=development

# Comma-separated allowed CORS origins for the frontend
ALLOWED_ORIGINS=http://localhost:3000

# Clerk secret key, test-mode until Phase 8 hardening
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Clerk publishable key, test-mode until Phase 8 hardening. Backend-only name,
# not NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, that variable belongs in frontend/.env.local
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# Overrides the write-rate-limit threshold during integration tests only, ignored outside NODE_ENV=test
RATE_LIMIT_WRITE_TEST=1000

# Port the backend listens on, Render provides this in production
PORT=4000
